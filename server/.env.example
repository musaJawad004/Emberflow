# Emberflow server environment — copy to server/.env and adjust.
# Real environment variables always override values in this file.

# HTTP/WS port the server listens on
EMBER_PORT=4100

# Path to the SQLite database file (default: server/data/emberflow.db)
# EMBER_DB=/absolute/path/to/emberflow.db

# Redis connection for the BullMQ run queue
REDIS_URL=redis://127.0.0.1:6379

# Stage execution backend: docker (default) or local (dev fallback, no isolation)
EMBER_EXECUTOR=docker

# Shared secret for GitHub webhook HMAC verification (x-hub-signature-256).
# Leave unset to accept webhooks unverified (dev mode, logs a warning).
# EMBER_WEBHOOK_SECRET=change-me

# Groq failure analyst. Without an API key the analyst is skipped gracefully.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
